# ---------------------------------------------------------------------------
# copy this file to ".env" and fill it in to turn on cross-device realtime.
# without it, the app still runs and syncs between tabs on the same computer.
# (vite only exposes variables that start with VITE_ to the app.)
# ---------------------------------------------------------------------------

# each person's own password — typing it logs straight into that account.
VITE_CODE_MEHREENZ=
VITE_CODE_ALI=

# the one shared world you both live in (keep identical for both people).
VITE_WORLD_ID=mehralizzz

# firebase realtime database — from your firebase project settings
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
